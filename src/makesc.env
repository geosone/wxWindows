# Common settings for Symantec

WXDIR = $(WXWIN)
INCDIR = $(WXDIR)\include
MSWINC = $(INCDIR)\msw
BASEINC = $(INCDIR)\base
INCLUDE = $(BASEINC);$(MSWINC);$(WXDIR)\contrib\fafa

SRCSUFF = cpp
OBJSUFF = obj

# default values

CC=sc
RC=rc

DEBUG=1

# WIN16 settings
#CFLAGS = -Jm -ml -W -Dwx_msw=1 -DDEBUG=$(DEBUG) # -o
#LDFLAGS = -ml -W
#LINKER = link
#LIBS=$(WXLIB) $(EXTRALIBS) libw.lib commdlg.lib ddeml.lib shell.lib
#DEFFILE=sc16.def

# WIN32 settings
CFLAGS = -Jm -mn -W -Dwx_msw=1 -DDEBUG=$(DEBUG) -DWIN32 -DWIN95=0 # -o
LDFLAGS = -Llink386.exe
LINKER = link386
DEFFILE=sc32.def
LIBS=$(WXLIB) $(EXTRALIBS) ctl3d32.lib shell32.lib comdlg32.lib user32.lib gdi32.lib winmm.lib
# Note: if you don't have ctl3d32.lib, try running:
# implib /system ctl3d32.lib ctl3d32.dll

.$(SRCSUFF).obj:
	*$(CC) -c $(CFLAGS) -I$(INCLUDE) $(OPTIONS) $<

.rc.res:
	*$(RC) -r -I$(INCLUDE) $<

