#
# Makefile : Builds wxWindows utils for GnuWin32.

# Replace this with your own path if necessary
WXDIR = ..

# Change these if needed.

THISDIR = $(WXDIR)/utils


all:	all_utils all_execs

motif:	all_motif

xview:	all_ol

all_motif:
	$(MAKE) -f makefile.g95 all

all_ol:
	$(MAKE) -f makefile.g95 all

all_utils:	do_wxtree do_wxgraph do_wxgrid do_wxtab do_wxprop do_wxchart # do_hytext

all_utils_motif:
	$(MAKE) -f makefile.g95 all_utils

all_utils_ol:
	$(MAKE) -f makefile.g95 all_utils

all_execs:	do_tex2rtf do_wxbuild do_colours do_dialoged # do_wxhelp

all_execs_motif:
	$(MAKE) -f makefile.g95 all_execs

all_execs_ol:
	$(MAKE) -f makefile.g95 all_execs

all_demos:	wxtab_demo wxgrid_demo wxtree_demo wxgraph_demo wxchart_demo

all_demos_motif:
	$(MAKE) -f makefile.g95 all_demos

all_demos_ol:
	$(MAKE) -f makefile.g95 all_demos

clean:  wxtree_clean wxgraph_clean wxgrid_clean wxtab_clean wxprop_clean\
 tex2rtf_clean wxbuild_clean colours_clean dialoged_clean # hytext_clean wxhelp_clean

clean_motif:
	$(MAKE) -f makefile.g95 clean

clean_ol:
	$(MAKE) -f makefile.g95 clean

do_xpmshow:	
	cd $(WXDIR)/utils/xpmshow/src; $(MAKE) -f makefile.g95

xpmshow_clean:	
	cd $(WXDIR)/utils/xpmshow/src; $(MAKE) -f makefile.g95 clean

do_hytext:	
	cd $(WXDIR)/utils/hytext/src; $(MAKE) -f makefile.g95

hytext_clean:	
	cd $(WXDIR)/utils/hytext/src; $(MAKE) -f makefile.g95 clean

do_wxhelp:	 hytext
	cd $(WXDIR)/utils/wxhelp/src; $(MAKE) -f makefile.g95

